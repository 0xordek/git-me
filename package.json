{
  "name": "git-me",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "git-me": "dist/cli.js"
  },
  "files": [
    "dist/cli.js"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "check": "npm test && npm run typecheck && npm run build:cli && npm run deploy:dry",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.107.1"
  }
}
